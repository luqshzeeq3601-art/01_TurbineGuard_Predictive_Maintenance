# TurbineGuard Environment Configuration Template
# Copy this file to .env for local runtime overrides

# Directory path to the frozen model bundle to load on startup
TURBINEGUARD_BUNDLE_DIR=models/v0.2.0

# Optional host and port for Uvicorn API server
TURBINEGUARD_HOST=127.0.0.1
TURBINEGUARD_PORT=8000

# Optional MLflow tracking URI for experiment metrics logging
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
